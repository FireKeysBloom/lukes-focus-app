# Copy this file to .env and fill in your own values — .env is gitignored
# and must never be committed. Get both values from your Supabase project:
# Supabase Dashboard -> Settings -> API
#
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon public" key (NOT the service_role key —
# never use the service_role key in this app; it bypasses Row Level Security).
#
# The anon key is safe to expose in a public repo/client bundle by design —
# Supabase's security model relies on RLS policies, not on hiding this key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
